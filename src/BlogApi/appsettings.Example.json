{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Aws": {
    "Region": "us-east-1",

    "DynamoDb": {
      "PostsTable": "blog-api-posts",
      "CommentsTable": "blog-api-comments"
    },

    "S3": {
      "BucketName": "FILL_WITH_TERRAFORM_OUTPUT"
    },

    "Cognito": {
      "UserPoolId": "FILL_WITH_TERRAFORM_OUTPUT",
      "ClientId": "FILL_WITH_TERRAFORM_OUTPUT"
    },

    "Sns": {
      "NovoComentarioTopicArn": "FILL_WITH_TERRAFORM_OUTPUT"
    },

    "Sqs": {
      "NotificacoesQueueUrl": "FILL_WITH_TERRAFORM_OUTPUT"
    },

    "CloudWatchLogGroup": "/blog-api/app"
  }
}